{
  "rules": {
    ".read": false,
    ".write": false,
    "v1": {
      "players": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 't'])",
          "n": { ".validate": "newData.isString() && newData.val().length <= 5 && newData.val().matches(/^[0-9]+-[0-9]+$/)" },
          "t": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 300000" },
          "$other": { ".validate": false }
        }
      },
      "scores": {
        "$board": {
          ".read": "auth != null",
          ".indexOn": ["s"],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $board.length <= 40 && $board.matches(/^[a-z]+(_[a-z]+)*$/)",
            ".validate": "newData.hasChildren(['s', 'n', 't'])",
            "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "n": { ".validate": "newData.isString() && newData.val().length <= 5 && newData.val().matches(/^[0-9]+-[0-9]+$/)" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 300000" },
            "l": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
            "m": { ".validate": "newData.isString() && newData.val().matches(/^(easy|normal|hard)$/)" },
            "$other": { ".validate": false }
          }
        }
      },
      "roomlist": {
        ".read": "auth != null",
        ".indexOn": ["t"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 't', 'c', 'k'])",
          "n": { ".validate": "newData.isString() && newData.val().length <= 5 && newData.val().matches(/^[0-9]+-[0-9]+$/)" },
          "t": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 300000" },
          "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "k": { ".validate": "newData.isString() && newData.val().length <= 12 && newData.val().matches(/^[a-z]+$/)" },
          "$other": { ".validate": false }
        }
      },
      "rooms": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 't', 'k', 'w', 'f', 'z'])",
          "n": { ".validate": "newData.isString() && newData.val().length <= 5 && newData.val().matches(/^[0-9]+-[0-9]+$/)" },
          "t": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 300000" },
          "k": { ".validate": "newData.isString() && newData.val().length <= 12 && newData.val().matches(/^[a-z]+$/)" },
          "w": { ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[a-z0-9_]+$/)" },
          "f": { ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[a-z0-9_]+$/)" },
          "z": { ".validate": "newData.isString() && newData.val().matches(/^(s|e|3|4)$/)" },
          "i": {
            "$k": {
              ".validate": "$k.matches(/^[0-9][0-9]?$/) && newData.hasChildren(['a', 'x', 'y'])",
              "a": { ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[a-z0-9_]+$/)" },
              "x": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 1000" },
              "y": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 1000" },
              "r": { ".validate": "newData.isBoolean()" },
              "s": { ".validate": "newData.isString() && newData.val().matches(/^l$/)" },
              "g": { ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^[a-z0-9_,]*$/)" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "photos": {
        ".read": "auth != null",
        ".indexOn": ["t"],
        "$key": {
          ".write": "auth != null && $key.beginsWith(auth.uid + '_') && $key.replace(auth.uid + '_', '').matches(/^[a-z0-9-]+$/) && $key.length <= 180",
          ".validate": "newData.hasChildren(['n', 't', 'b', 'k', 'z', 'r', 'c', 'o'])",
          "n": { ".validate": "newData.isString() && newData.val().length <= 5 && newData.val().matches(/^[0-9]+-[0-9]+$/)" },
          "t": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 300000" },
          "b": { ".validate": "newData.isString() && newData.val().length <= 16 && newData.val().matches(/^[a-z]+$/)" },
          "k": { ".validate": "newData.isString() && newData.val().length <= 12 && newData.val().matches(/^[a-z]+$/)" },
          "z": { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)" },
          "r": { ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[a-z]+,[a-z]+,[a-z]+$/)" },
          "c": { ".validate": "newData.isString() && newData.val().length <= 90 && newData.val().matches(/^[a-z]+[.][a-z]+,[a-z]+[.][a-z]+,[a-z]+[.][a-z]+$/)" },
          "o": { ".validate": "newData.isString() && newData.val().length <= 900 && newData.val().matches(/^[a-z0-9_=;:|]*$/)" },
          "m": { ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[0-9.,-]+$/)" },
          "p": { ".validate": "newData.isString() && newData.val().length <= 6200 && newData.val().matches(/^[A-Za-z0-9_,-]*$/)" },
          "s": { ".validate": "newData.isString() && newData.val().length <= 800 && newData.val().matches(/^[a-z0-9.,-]*$/)" },
          "x": { ".validate": "newData.isString() && newData.val().length <= 140 && newData.val().matches(/^[0-9.,-]*$/)" },
          "e": { ".validate": "newData.isString() && newData.val().length <= 80 && newData.val().matches(/^[a-z,]*$/)" },
          "$other": { ".validate": false }
        }
      },
      "reportcount": {
        ".read": "auth != null",
        "$key": {
          ".write": "auth != null && newData.isNumber() && ((newData.val() === (data.exists() ? data.val() : 0) + 1 && !root.child('v1/reportlog').child($key).child(auth.uid).exists() && newData.parent().parent().child('reportlog').child($key).child(auth.uid).exists()) || (data.exists() && newData.val() === data.val() - 1 && root.child('v1/reportlog').child($key).child(auth.uid).exists() && !newData.parent().parent().child('reportlog').child($key).child(auth.uid).exists()))"
        }
      },
      "reportlog": {
        "$key": {
          "$rid": {
            ".write": "auth != null && auth.uid === $rid && ((!data.exists() && newData.isString() && newData.val().matches(/^(bad|spam)$/) && !$key.beginsWith(auth.uid + '_') && root.child('v1/photos').child($key).exists() && newData.parent().parent().parent().child('reportcount').child($key).val() === (root.child('v1/reportcount').child($key).exists() ? root.child('v1/reportcount').child($key).val() : 0) + 1) || (data.exists() && !newData.exists() && newData.parent().parent().parent().child('reportcount').child($key).val() === root.child('v1/reportcount').child($key).val() - 1))"
          }
        }
      },
      "kuji": {
        "$store": {
          ".read": "auth != null",
          ".validate": "$store.matches(/^(lawson|sevenbun)$/)",
          "cur": {
            ".write": "auth != null && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 1) + 1 && data.parent().child('lots').child('l' + (data.exists() ? data.val() : 1)).child('n').val() === 80"
          },
          "lots": {
            "$lot": {
              "n": {
                ".write": "auth != null && $lot === 'l' + (root.child('v1/kuji').child($store).child('cur').exists() ? root.child('v1/kuji').child($store).child('cur').val() : 1) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && newData.val() <= 80 && !data.parent().child('d').child('k' + (newData.val() - 1)).exists() && newData.parent().child('d').child('k' + (newData.val() - 1)).child('u').val() === auth.uid"
              },
              "pc": {
                ".write": "auth != null && data.parent().child('n').exists() && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
              },
              "d": {
                "$k": {
                  ".write": "auth != null && !data.exists() && $k === 'k' + (data.parent().parent().child('n').exists() ? data.parent().parent().child('n').val() : 0) && newData.parent().parent().child('n').val() === (data.parent().parent().child('n').exists() ? data.parent().parent().child('n').val() : 0) + 1 && newData.child('u').val() === auth.uid && newData.child('t').val() === now && !newData.child('p').exists() && !newData.child('o').exists()",
                  ".validate": "newData.hasChildren(['u', 't'])",
                  "u": {
                    ".write": "auth != null && data.val() === auth.uid && newData.val() === ''",
                    ".validate": "newData.isString() && newData.val().length <= 128"
                  },
                  "t": { ".validate": "newData.isNumber()" },
                  "p": {
                    ".write": "auth != null && !data.exists() && data.parent().child('u').val() === auth.uid",
                    ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2) && newData.parent().child('o').exists()"
                  },
                  "o": {
                    ".write": "auth != null && !data.exists() && data.parent().child('u').val() === auth.uid",
                    ".validate": "newData.isNumber() && newData.val() === (data.parent().parent().parent().child('pc').exists() ? data.parent().parent().parent().child('pc').val() : 0) && newData.parent().parent().parent().child('pc').val() === newData.val() + 1 && newData.parent().child('p').exists()"
                  },
                  "$other": { ".validate": false }
                }
              },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "kujime": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren()",
          "$key": { ".validate": "newData.val() === true && $key.matches(/^(lawson|sevenbun)_l[0-9]{1,6}$/)" }
        }
      }
    }
  }
}
